# Supabase project credentials
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"
SUPABASE_URL="https://your-project-id.supabase.co"

# Vite client-side Supabase variables
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-side QR token signing secret
# Use a long random string in production. Never commit the real value.
QR_SIGNING_SECRET="change-me-to-a-strong-random-secret-at-least-32-chars"
